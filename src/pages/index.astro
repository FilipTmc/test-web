---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { usluge } from "../data/usluge";
import heroMain from "../assets/heroMain.jpg";
import heroMain2 from "../assets/heroMain2.jpg";
import heroMain3 from "../assets/heroMain3.jpg";
---

<Layout title="LeonMedia — produkcija, mediji i dizajn, Slavonski Brod">

  <section class="relative isolate flex min-h-[82vh] items-end overflow-hidden">
    <Image src={heroMain} alt="Snimka naselja iz zraka" loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/85 to-ink/30"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-transparent to-ink/60"></div>

    <div class="relative mx-auto w-full max-w-6xl px-6 pb-24 pt-40">
      <p class="rise rise-1 font-mono text-[11px] uppercase tracking-[0.3em] text-signal">
        Brodsko-posavska županija
      </p>

      <h1 class="rise rise-2 mt-6 max-w-3xl font-display text-4xl font-extrabold leading-[1.02] tracking-[-0.03em] sm:text-6xl lg:text-7xl">
        Produkcija, mediji i dizajn na jednom mjestu.
      </h1>

      <p class="rise rise-3 mt-8 max-w-xl text-lg leading-relaxed text-mist">
        Fotografija, snimanje dronom, društvene mreže, web stranice, novinarski tekstovi i grafička priprema — za tvrtke, općine, ustanove i udruge.
      </p>

      <div class="rise rise-4 mt-10 flex flex-wrap gap-3">
        <a href="/kontakt" class="bg-signal px-7 py-4 font-mono text-[11px] uppercase tracking-[0.18em] text-white transition-transform hover:-translate-y-0.5">
          Zatraži ponudu
        </a>
        <a href="/usluge" class="border border-white/25 px-7 py-4 font-mono text-[11px] uppercase tracking-[0.18em] text-paper transition-colors hover:border-white/60">
          Sve usluge
        </a>
      </div>
    </div>
  </section>

  <!-- USLUGE -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-white/10 pb-6">
      <h2 class="font-display text-3xl font-extrabold tracking-[-0.02em] sm:text-4xl">Usluge</h2>
      <p class="max-w-md text-sm leading-relaxed text-mist">
        Šest područja koja se najčešće naručuju zajedno — jedan izlazak na teren pokriva više njih.
      </p>
    </div>

    <div class="mt-12 grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
      {usluge.map((u) => (
        <a href={`/usluge/${u.slug}`} class="group flex flex-col bg-ink transition-colors hover:bg-surface">
          <div class="relative aspect-[16/10] overflow-hidden">
            <Image src={u.slika} alt={u.alt} class="h-full w-full object-cover opacity-55 transition duration-500 group-hover:scale-[1.04] group-hover:opacity-80" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink to-transparent"></div>
          </div>
          <div class="flex flex-1 flex-col p-7">
            <h3 class="font-display text-xl font-bold tracking-[-0.02em]">{u.naziv}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-mist">{u.kratko}</p>
            <span class="mt-6 font-mono text-[11px] uppercase tracking-[0.2em] text-signal">
              Detaljnije →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- IZ ZRAKA -->
  <section class="border-y border-white/10 bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-signal">Snimanje iz zraka</p>
          <h2 class="mt-5 font-display text-3xl font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-5xl">
            Cijelo naselje u jednom kadru.
          </h2>
        </div>
        <p class="text-lg leading-relaxed text-mist">
          Općine i tvrtke najčešće traže snimke iz zraka kad treba pokazati opseg — završen projekt, uređenu javnu površinu ili razmjer zahvata. Iz zraka se to vidi odjednom, bez dvadeset fotografija s ceste.
        </p>
      </div>

      <div class="mt-14 grid gap-px bg-white/10 sm:grid-cols-2">
        <Image src={heroMain2} alt="Naselje snimljeno dronom" class="aspect-[4/3] w-full object-cover" />
        <Image src={heroMain3} alt="Pogled iz zraka na okolicu" class="aspect-[4/3] w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- PORTALI -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.3em] text-signal">Uz produkciju</p>
        <h2 class="mt-5 font-display text-3xl font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-5xl">
          Snimljeno danas,<br />objavljeno danas.
        </h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed text-mist">
          Uz produkciju vodim i dva lokalna portala. Vaš događaj ne mora čekati da ga netko drugi primijeti — može biti objavljen isti dan, pred publikom koja živi u vašoj općini.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://bpinfo.hr" class="border border-white/15 px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-paper transition-colors hover:border-signal">bpinfo.hr</a>
          <a href="https://orionet.com.hr" class="border border-white/15 px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-paper transition-colors hover:border-signal">orionet.com.hr</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-24 text-center">
      <h2 class="mx-auto max-w-2xl font-display text-3xl font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-5xl">
        Recite što vam treba i kada.
      </h2>
      <p class="mx-auto mt-6 max-w-md leading-relaxed text-mist">
        Ponuda stiže isti dan, s jasnom cijenom i rokom.
      </p>
      <a href="/kontakt" class="mt-10 inline-block bg-signal px-9 py-4 font-mono text-[11px] uppercase tracking-[0.18em] text-white transition-transform hover:-translate-y-0.5">
        Zatraži ponudu
      </a>
    </div>
  </section>

</Layout>