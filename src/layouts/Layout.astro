---
import "../styles/global.css";

const { title = "LeonMedia" } = Astro.props;
const putanja = Astro.url.pathname;

const linkovi = [
  { naziv: "Naslovnica", href: "/" },
  { naziv: "O nama", href: "/o-nama" },
  { naziv: "Kontakt", href: "/kontakt" },
];

function klasaLinka(href: string) {
  return "font-mono text-[11px] uppercase tracking-[0.22em] transition-colors " +
    (putanja === href ? "text-paper" : "text-mist hover:text-paper");
}

function klasaMobilnog(href: string) {
  return "block font-display text-4xl font-extrabold tracking-[-0.03em] transition-colors " +
    (putanja === href ? "text-signal" : "text-paper");
}
---

<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-ink font-sans text-paper antialiased flex flex-col">

    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink/60 backdrop-blur-xl">
      <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="/" class="relative z-50 flex items-center gap-2.5">
          <span class="h-2.5 w-2.5 rotate-45 bg-signal"></span>
          <span class="font-display text-lg font-extrabold tracking-[-0.02em]">LeonMedia</span>
        </a>

        <!-- desktop -->
        <div class="hidden items-center gap-7 sm:flex">
          <ul class="flex gap-7">
            {linkovi.map((link) => (
              <li><a href={link.href} class={klasaLinka(link.href)}>{link.naziv}</a></li>
            ))}
          </ul>
          <a href="/kontakt" class="border border-signal/60 bg-signal/10 px-4 py-2 font-mono text-[11px] uppercase tracking-[0.18em] text-paper transition-colors hover:bg-signal">
            Javi se
          </a>
        </div>

        <!-- mobitel -->
        <button
          id="meni-gumb"
          type="button"
          class="burger relative z-50 sm:hidden"
          aria-label="Izbornik"
          aria-expanded="false"
          aria-controls="meni-panel"
        >
          <span></span><span></span>
        </button>
      </nav>
    </header>

    <!-- mobilni panel -->
    <div id="meni-panel" class="fixed inset-x-0 bottom-0 top-16 z-40 hidden bg-ink sm:hidden">
      <div class="flex h-full flex-col justify-between px-6 pb-10 pt-12">
        <ul class="space-y-7">
          {linkovi.map((link) => (
            <li><a href={link.href} class={klasaMobilnog(link.href)}>{link.naziv}</a></li>
          ))}
        </ul>

        <div>
          <a href="/kontakt" class="block bg-signal px-7 py-4 text-center font-mono text-[11px] uppercase tracking-[0.18em] text-white">
            Zatraži ponudu
          </a>
          <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.2em] text-mist">097 631 1213</p>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.2em] text-mist">orionet6@gmail.com</p>
        </div>
      </div>
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-ink">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-display text-3xl font-extrabold tracking-[-0.02em]">LeonMedia</p>
            <p class="mt-2 max-w-xs text-sm text-mist">Foto, video i dron produkcija — Slavonski Brod.</p>
          </div>
          <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-mist">
            <p>097 631 1213</p>
            <p class="mt-1.5">orionet6@gmail.com</p>
            <p class="mt-1.5 text-white/30">45.1603° N &nbsp; 18.0156° E</p>
          </div>
        </div>
        <p class="mt-10 border-t border-white/10 pt-6 font-mono text-[10px] uppercase tracking-[0.2em] text-white/30">
          © {new Date().getFullYear()} LeonMedia j.d.o.o.
        </p>
      </div>
    </footer>

    <script>
      const gumb = document.getElementById("meni-gumb");
      const panel = document.getElementById("meni-panel");

      if (gumb && panel) {
        const postavi = (otvoren: boolean) => {
          gumb.setAttribute("aria-expanded", String(otvoren));
          panel.classList.toggle("hidden", !otvoren);
          document.body.classList.toggle("overflow-hidden", otvoren);
        };

        gumb.addEventListener("click", () => {
          postavi(gumb.getAttribute("aria-expanded") !== "true");
        });

        panel.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => postavi(false));
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") postavi(false);
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth >= 640) postavi(false);
        });
      }
    </script>

    <style>
      .burger {
        width: 2.5rem;
        height: 2.5rem;
      }
      .burger span {
        position: absolute;
        left: 50%;
        display: block;
        height: 1.5px;
        width: 1.375rem;
        background: #f2f4f8;
        transform: translateX(-50%);
        transition: transform 0.3s ease, top 0.3s ease;
      }
      .burger span:nth-child(1) { top: calc(50% - 4px); }
      .burger span:nth-child(2) { top: calc(50% + 4px); }

      .burger[aria-expanded="true"] span:nth-child(1) {
        top: 50%;
        transform: translateX(-50%) rotate(45deg);
      }
      .burger[aria-expanded="true"] span:nth-child(2) {
        top: 50%;
        transform: translateX(-50%) rotate(-45deg);
      }

      @media (prefers-reduced-motion: reduce) {
        .burger span { transition: none; }
      }
    </style>

  </body>
</html>